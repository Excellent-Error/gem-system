# ---- GEM System backend environment ----

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Auth session length (seconds). Default 8 hours.
JWT_EXPIRES_SECONDS=28800

# Database driver: "sqlite" (default, requires Node >= 22.5) or "json" (any Node 20+)
DB_DRIVER=sqlite
DATA_DIR=./data

# Allowed frontend origins (comma-separated). Must match where the frontend is served from.
CORS_ORIGINS=http://localhost:5173

# Set to true when serving over HTTPS (adds Secure flag to the auth cookie)
COOKIE_SECURE=false

# Rate limiting
PUBLIC_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# Max request body size in bytes
MAX_BODY_BYTES=102400
